[Unit]
Description=Mess TV Bot: poll Slack for content and rebuild slideshow manifest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/messtvbot
EnvironmentFile=%h/messtvbot/config/kiosk.env
ExecStart=%h/messtvbot/.venv/bin/python3 %h/messtvbot/bin/refresh.py
