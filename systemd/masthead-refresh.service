[Unit]
Description=Masthead: poll Slack for content and rebuild slideshow manifest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/masthead
EnvironmentFile=%h/masthead/config/masthead.env
ExecStart=/usr/bin/python3 %h/masthead/bin/masthead-refresh.py
