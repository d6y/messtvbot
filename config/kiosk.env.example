# Copy this file to kiosk.env and fill in your values.
#   cp config/kiosk.env.example config/kiosk.env
#
# kiosk.env is read by:
#   - bin/refresh.py (Slack poll + render + manifest)
#   - bin/serve.sh   (local web server)
#   - kiosk/launch-kiosk-*.sh (browser launch)

# Slack bot token (xoxb-...) with scopes: channels:history (or
# groups:history for a private channel), files:read, users:read,
# chat:write.
KIOSK_SLACK_TOKEN=xoxb-your-bot-token

# The Slack channel ID to read content from (e.g. C0123456789 -- find
# it in the channel's "About" panel in Slack, or via the Slack API).
KIOSK_SLACK_CHANNEL=C0123456789

# How many days a Slack message stays valid before it auto-expires
# from the rotation.
KIOSK_SLACK_TTL_DAYS=30

# Where downloaded content, rendered PDF pages, and the manifest live.
# Defaults to ~/kiosk-data if unset.
KIOSK_DIR=$HOME/kiosk-data

# Port for the local kiosk web server.
KIOSK_PORT=8420

# How wide (px) to render PDF pages. Match your screen's horizontal
# resolution for crisp text; smaller is faster to render.
KIOSK_RENDER_WIDTH=1920

# How long each slide stays on screen, in seconds.
KIOSK_SLIDE_SECONDS=8

# How often the browser re-checks manifest.json for changes, in seconds.
# (Separate from how often refresh.py itself runs -- that's
# controlled by the systemd timer / launchd interval / cron schedule.)
KIOSK_POLL_SECONDS=30

# Address the web server binds to. Leave as 127.0.0.1 to keep it
# reachable only from this machine. Set to 0.0.0.0 to make the
# slideshow page (and /admin, /api -- see below) reachable from other
# devices on your LAN. There's no HTTPS here, so only do this on a
# network you trust.
KIOSK_BIND_HOST=127.0.0.1

# Username/password required for /admin and /api (Basic Auth). Leave
# both unset to leave /admin and /api open with no login -- fine when
# KIOSK_BIND_HOST is 127.0.0.1, but set these before exposing the
# server to the LAN, or anyone on the network can remove signage
# content with no credentials at all.
ADMIN_USER=
ADMIN_PASS=

# URL the bot points people to (e.g. in its help reply) for the admin
# page. Leave unset to default to http://<this machine's hostname>:<KIOSK_PORT>.
# Set explicitly if that hostname isn't reachable from where people are
# (e.g. use a LAN IP or a name from your router/DNS instead).
KIOSK_SERVER_URL=

# Who the bot's help reply tells people to contact if it's broken.
KIOSK_ADMIN_CONTACT=@richard

# Max images used from a single multi-image post (e.g. 9 photos attached
# to one message). Extras are silently ignored -- the bot's reply notes
# how many were dropped so the poster isn't left guessing. Doesn't apply
# to a single image or a PDF/video (those are unaffected either way).
KIOSK_MAX_IMAGES=6
