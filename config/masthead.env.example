# Copy this file to masthead.env and fill in your values.
#   cp config/masthead.env.example config/masthead.env
#
# masthead.env is read by:
#   - bin/masthead-refresh.py (sync + render + manifest)
#   - bin/masthead-serve.sh   (local web server)
#   - kiosk/launch-kiosk-*.sh (browser launch)

# The rclone remote:path to sync from. Set this up first with:
#   rclone config
# then point it at the folder your team edits, e.g.:
MASTHEAD_REMOTE=dropbox:Masthead

# Where synced content, rendered PDF pages, and the manifest live.
# Defaults to ~/masthead-data if unset.
MASTHEAD_DIR=$HOME/masthead-data

# Port for the local kiosk web server.
MASTHEAD_PORT=8420

# How wide (px) to render PDF pages. Match your screen's horizontal
# resolution for crisp text; smaller is faster to render.
MASTHEAD_RENDER_WIDTH=1920

# How long each slide stays on screen, in seconds.
MASTHEAD_SLIDE_SECONDS=8

# How often the browser re-checks manifest.json for changes, in seconds.
# (Separate from how often masthead-refresh.py itself runs -- that's
# controlled by the systemd timer / launchd interval / cron schedule.)
MASTHEAD_POLL_SECONDS=30
